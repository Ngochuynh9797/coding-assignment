{
  "name": "workout-logging-api",
  "version": "0.1.0",
  "private": true,
  "description": "Workout Logging API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --env-file .env",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --rootDir . --testRegex \"test/e2e/.*\\.e2e-spec\\.ts$\" --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
